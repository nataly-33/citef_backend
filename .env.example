# SISTEMA CITEF FCEE - UAGRM | VARIABLES DE ENTORNO BACKEND (NestJS)

# 1. SERVIDOR HTTP Y APLICACIÓN
PORT=3000
FRONTEND_URL=http://localhost:4200

# 2. BASE DE DATOS RELACIONAL (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=citef_admin
DB_PASSWORD=citef_123
DB_NAME=citef_db

# 3. SEGURIDAD, CRIPTOGRAFÍA Y JSON WEB TOKEN (JWT)
JWT_SECRET=super_secret_citef_key_2026_uagrm_fcee_security
JWT_EXPIRATION=24h

# 4. SERVICIO DE CORREO TRANSACCIONAL - BREVO REST API (CU2)
# Pasos para obtener sus credenciales gratuitas:
# 1. Regístrese gratis en: https://app.brevo.com
# 2. Confirme el correo de activación que Brevo enviará a su bandeja.
# 3. Ingrese a: https://app.brevo.com/settings/keys/api
# 4. En la pestaña "API Keys", haga clic en "Generar una nueva clave API" (Generate a new API key).
# 5. Copie la clave generada (inicia con `xkeysib-...`) en la variable BREVO_API_KEY:
BREVO_API_KEY=
BREVO_SENDER_EMAIL=su_correo_registrado_en_brevo@gmail.com
BREVO_SENDER_NAME="CITEF FCEE UAGRM"

# 5. MICROSERVICIO ANALÍTICA PREDICTIVA MACHINE LEARNING (FastAPI Python)
FASTAPI_ANALYTICS_URL=http://localhost:8001/api/v1/ml

